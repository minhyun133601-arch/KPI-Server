# Active internal server runtime state
kpi-runtime/internal-server/.env
kpi-runtime/internal-server/.env.*
!kpi-runtime/internal-server/.env.example
!kpi-runtime/internal-server/.env*.example
kpi-runtime/internal-server/var/*
!kpi-runtime/internal-server/var/.gitkeep
!kpi-runtime/internal-server/var/files/.gitkeep
!kpi-runtime/internal-server/var/logs/.gitkeep
!kpi-runtime/internal-server/var/migration-backups/.gitkeep
!kpi-runtime/internal-server/var/backups/.gitkeep
!kpi-runtime/internal-server/var/backups/file-storage/.gitkeep
!kpi-runtime/internal-server/var/backups/runtime-snapshots/.gitkeep

# Local verification/runtime scratch
.env
.env.*
!.env.example
!**/.env*.example
.codex-run/
**/internal-server/.codex-run/
.claude/scheduled_tasks.lock
.claude/settings.local.json
.superloopy/
.playwright-mcp/
test-results/
*.log

# Session notes and work logs are local artifacts, not repository structure.
/work-log/

# Imported handoff folders are review inputs, not repo structure.
kpi-server-repository-map-handoff/

# Nested local reference clone; keep it out of the parent repo.
KPI-local/
