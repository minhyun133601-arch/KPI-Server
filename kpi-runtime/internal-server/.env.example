KPI_SERVER_HOST=0.0.0.0
KPI_SERVER_PORT=3100
KPI_DATABASE_URL=postgresql://kpi_app:replace-with-db-password@127.0.0.1:5434/kpi_internal
KPI_POSTGRES_SUPERUSER_USERNAME=postgres
KPI_POSTGRES_SUPERUSER_PASSWORD=replace-with-postgres-superuser-password
KPI_AUTH_ENABLED=true
KPI_LOGIN_ENABLED=true
KPI_COOKIE_SECRET=replace-with-long-random-secret
KPI_COOKIE_SECURE=false
KPI_SESSION_TTL_HOURS=12
KPI_SESSION_PRUNE_INTERVAL_MINUTES=30
KPI_LOGIN_RATE_LIMIT_ENABLED=true
KPI_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
KPI_LOGIN_RATE_LIMIT_WINDOW_MS=900000
KPI_SECURITY_HEADERS_ENABLED=true
KPI_CONTENT_SECURITY_POLICY=
KPI_FRAME_OPTIONS=SAMEORIGIN
KPI_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=()
KPI_HSTS_ENABLED=false
KPI_STORAGE_ROOT=./var/prod
KPI_AUTO_MIGRATE=true
KPI_INITIAL_OWNER_USERNAME=owner
KPI_INITIAL_OWNER_DISPLAY_NAME=KPI Owner
KPI_INITIAL_OWNER_PASSWORD=replace-with-initial-owner-password
