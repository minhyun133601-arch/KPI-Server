COMPOSE_PROJECT_NAME=kpi-onprem
POSTGRES_DB=kpi_internal
POSTGRES_USER=kpi_app
POSTGRES_PASSWORD=change-this-before-production
KPI_COOKIE_SECRET=change-this-before-production
KPI_COOKIE_SECURE=true
KPI_SERVER_PORT=3100
KPI_SESSION_TTL_HOURS=12
KPI_SESSION_PRUNE_INTERVAL_MINUTES=30
KPI_LOGIN_RATE_LIMIT_ENABLED=true
KPI_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
KPI_LOGIN_RATE_LIMIT_WINDOW_MS=900000
KPI_SECURITY_HEADERS_ENABLED=true
KPI_CONTENT_SECURITY_POLICY=
KPI_FRAME_OPTIONS=SAMEORIGIN
KPI_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=()
KPI_HSTS_ENABLED=true
KPI_AUTO_MIGRATE=false
KPI_PUBLIC_HOST=app.example.com
