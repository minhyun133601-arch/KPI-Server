# Home PC / development preview
KPI_SERVER_HOST=127.0.0.1
KPI_SERVER_PORT=3100
KPI_DATABASE_URL=postgresql://kpi_dev:replace-with-dev-db-password@127.0.0.1:5434/kpi_dev
KPI_POSTGRES_SUPERUSER_USERNAME=postgres
KPI_POSTGRES_SUPERUSER_PASSWORD=replace-with-postgres-superuser-password
KPI_AUTH_ENABLED=false
KPI_LOGIN_ENABLED=false
KPI_COOKIE_SECRET=replace-with-dev-cookie-secret
KPI_COOKIE_SECURE=false
KPI_SESSION_TTL_HOURS=12
KPI_SESSION_PRUNE_INTERVAL_MINUTES=30
# Exact username allowed to see the team report LAB; leave blank to disable.
KPI_TEAM_REPORT_DOCUMENT_EXPERIMENT_USERNAME=
KPI_STORAGE_ROOT=./var/dev
KPI_AUTO_MIGRATE=true
KPI_INITIAL_OWNER_USERNAME=owner
KPI_INITIAL_OWNER_DISPLAY_NAME=KPI Owner
KPI_INITIAL_OWNER_PASSWORD=replace-with-initial-owner-password
