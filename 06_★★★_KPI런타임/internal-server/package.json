{
  "name": "kpi-internal-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internal Node and PostgreSQL baseline for KPI serverization",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "backup:runtime-snapshot": "node src/scripts/backupRuntimeSnapshot.js",
    "cleanup:legacy-util-production-daily": "node src/scripts/cleanupLegacyUtilProductionDailyRecord.js",
    "db:migrate": "node src/scripts/migrate.js",
    "migrate:audit-lux-evidence": "node src/scripts/one-shot/migrateAuditLuxEvidence.js",
    "migrate:metering-authority-split": "node src/scripts/one-shot/migrateMeteringAuthoritySplit.js",
    "migrate:metering-billing-docs": "node src/scripts/one-shot/migrateMeteringBillingDocuments.js",
    "migrate:util-production-daily": "node src/scripts/one-shot/migrateUtilProductionDailyToStructuredModel.js",
    "migrate:work-history-reports": "node src/scripts/one-shot/migrateWorkHistoryReportRecords.js",
    "repair:work-history-report-authority": "node src/scripts/one-shot/repairWorkHistoryReportAuthority.js",
    "repair:metering-billing-storage": "node src/scripts/one-shot/repairMeteringBillingDocumentStorage.js",
    "sessions:prune": "node src/scripts/pruneExpiredSessions.js",
    "report:legacy-attachments": "node src/scripts/reportLegacyAttachmentStatus.js",
    "restore:runtime-snapshot": "node src/scripts/restoreRuntimeSnapshot.js",
    "seed:work-runtime": "node src/scripts/seedWorkRuntimeBootstrap.js",
    "user:reset-password": "node src/scripts/resetUserPassword.js",
    "smoke:kpi-root": "node src/scripts/verifyKpiRootStatic.js",
    "verify:cleanup-baseline": "npm run smoke:kpi-root && npm run cleanup:legacy-util-production-daily && npm run report:legacy-attachments",
    "verify:server-structure": "node src/scripts/verifyServerStructure.js",
    "verify": "npm run verify:cleanup-baseline && npm run verify:server-structure && npm test"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
